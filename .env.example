# Is file ki copy banao, naam ".env" rakho, aur apni values bharo. .env kabhi git mein commit mat karna.

# Twilio console (console.twilio.com) ke home page se:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Twilio ka trial number, + aur country code ke saath:
TWILIO_NUMBER=+1XXXXXXXXXX

# Server ka public https URL (cloudflared/ngrok tunnel ya Render deploy), aakhir mein / nahi:
PUBLIC_BASE_URL=https://example.trycloudflare.com

# Admin page se "call me" chalane ke liye apna khud ka lamba random password:
ADMIN_TOKEN=change-me-to-a-long-random-string
